{
  "manifest_version": 3,
  "name": "GlideVideo",
  "version": "0.0.0",
  "description": "placeholder — version and description are written from package.json at build time",
  "browser_specific_settings": {
    "gecko": {
      "id": "glidevideo@quantavil.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Toggle GlideVideo on this site",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
