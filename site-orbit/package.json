{
  "name": "site-orbit",
  "version": "1.1.0",
  "description": "Private Domain & Tech Observatory caching verified Tranco global ranks, tech stack, DNS infrastructure, and live performance metrics.",
  "type": "module",
  "author": "quantavil",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "prebuild": "bun scripts/generate-suffixes.ts",
    "build:userscript": "vite build",
    "build:extension": "vite build -c vite.extension.config.ts",
    "build": "bun run build:userscript && bun run build:extension",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "generate:suffixes": "bun scripts/generate-suffixes.ts",
    "check": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "preact": "^11.0.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@happy-dom/global-registrator": "^20.14.6",
    "@testing-library/preact": "^3.2.4",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-monkey": "^8.1.1"
  }
}
